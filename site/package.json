{
	"name": "sparxml-site",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.17.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"content": "node scripts/sync-docs.mjs && pnpm content:api",
		"content:api": "uv run --no-project --python 3.12 --with griffe==2.3.0 python scripts/gen_api.py",
		"dev": "pnpm content && astro dev",
		"build": "pnpm content && astro build",
		"preview": "astro preview",
		"check": "astro check && tsc --noEmit -p .",
		"test": "bun test test/",
		"shots": "node scripts/shots.mjs",
		"og": "node scripts/og.mjs",
		"deploy": "wrangler deploy && wrangler deploy -c deploy/redirect/wrangler.jsonc",
		"deploy:preview": "wrangler deploy -c deploy/preview/wrangler.jsonc"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "7.3.1",
		"@astrojs/starlight": "0.42.3",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"astro": "7.3.4",
		"katex": "0.18.7",
		"rehype-katex": "7.0.1",
		"remark-gfm": "4.0.1",
		"remark-math": "6.0.0",
		"remark-parse": "11.0.0",
		"sharp": "0.35.4",
		"starlight-links-validator": "0.26.0",
		"unified": "11.0.5",
		"unist-util-visit": "5.1.0"
	},
	"devDependencies": {
		"@types/bun": "1.3.2",
		"playwright-core": "1.59.1",
		"typescript": "6.0.3",
		"wrangler": "4.145.0"
	}
}
