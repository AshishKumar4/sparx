---
// Two copies of one Brunel network that part after one nudged neuron (src/widgets/twins.ts).
import Choice from './Choice.astro';
import Figure from './Figure.astro';
---

<div data-twins>
	<Figure engine="brunel × 2" height="18rem">
		<canvas role="img" aria-label="Spikes of 120 neurons in two copies of one network, grey where both copies fire and coloured where only one does, and below, the share of spikes that differ"></canvas>
		<Fragment slot="controls">
			<div class="sx-buttons"><button type="button" data-act="nudge" class="sx-button primary">Nudge one neuron</button><button class="sx-button" type="button" data-act="restart">Start over</button></div>
			<Choice name="regime" label="Regime" value="5,2" options={[{ value: '5,2', label: 'Asynchronous irregular' }, { value: '3,2', label: 'Synchronous regular' }]} />
		</Fragment>
		<p slot="after" class="sx-readout" data-status aria-live="polite"></p>
	</Figure>
</div>

<script>
	import { controls } from '../../widgets/controls';
	import { type TwinsFigure, twins } from '../../widgets/twins';
	import { whenNear } from '../../widgets/theme';

	for (const root of document.querySelectorAll<HTMLElement>('[data-twins]')) {
		let figure: TwinsFigure | null = null;
		const ui = controls(root, () => figure?.restart());
		const regime = () => {
			const [g, eta] = ui.choice('regime').split(',').map(Number);
			return { g, eta };
		};
		whenNear(root, () => (figure = twins(root, regime)), '200px');
		root.querySelector('[data-act="nudge"]')?.addEventListener('click', () => figure?.nudge());
		root.querySelector('[data-act="restart"]')?.addEventListener('click', () => figure?.restart());
	}
</script>

<style>
	.sx-button.primary {
		background: var(--sx-bio);
		border-color: var(--sx-bio);
	}
</style>
