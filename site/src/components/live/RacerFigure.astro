---
// The racer of the front page in a figure: the trained network driving tracks the reader picks or draws
// (src/widgets/racer/hero.ts on src/engines/racer.ts, held to sparx).
import Figure from './Figure.astro';
---

<div class="racer-figure" data-racer-figure>
	<Figure engine="Racer" height="26rem">
		<canvas data-racer-stage role="img" aria-label="A car driven by a spiking network around a closed track from its event camera's output, above the camera's pixels as they fire, the network's 160 neurons as they spike, and its steering and speed"></canvas>
		<div class="net" data-racer-net aria-hidden="true"></div>
		<div slot="controls" class="buttons">
			<button type="button" data-act="track">New track</button>
			<button type="button" data-act="draw" aria-pressed="false">Draw a track</button>
			<button type="button" data-act="pause" aria-pressed="false">Pause</button>
		</div>
		<p slot="after" class="readout">
			events <b data-events>0</b> · spikes <b data-spikes>0</b> a step · <b data-lap>…</b>
		</p>
	</Figure>
</div>

<script>
	import { racerHero } from '../../widgets/racer/hero';

	for (const root of document.querySelectorAll<HTMLElement>('[data-racer-figure]')) {
		const field = (name: string) => root.querySelector<HTMLElement>(`[data-${name}]`) as HTMLElement;
		const draw = root.querySelector<HTMLButtonElement>('[data-act="draw"]') as HTMLButtonElement;
		const pause = root.querySelector<HTMLButtonElement>('[data-act="pause"]') as HTMLButtonElement;
		new IntersectionObserver(async ([entry], observer) => {
			if (!entry.isIntersecting) return;
			observer.disconnect();
			const car = racerHero(root, await (await fetch('/racer/racer.json')).json(), (state) => {
				field('events').textContent = String(state.events);
				field('spikes').textContent = String(state.spikes);
				field('lap').textContent = state.crashed ? 'off the road: starting again' : state.lap === null ? `lap ${state.laps + 1} under way` : `last lap ${state.lap.toFixed(1)} s`;
				draw.setAttribute('aria-pressed', String(root.dataset.drawing === 'true'));
			});
			const paused = (value: boolean) => {
				car.setPaused(value);
				pause.setAttribute('aria-pressed', String(value));
				pause.textContent = value ? 'Play' : 'Pause';
			};
			paused(car.paused);
			root.querySelector('[data-act="track"]')?.addEventListener('click', () => car.newTrack());
			draw.addEventListener('click', () => car.draw(root.dataset.drawing !== 'true'));
			pause.addEventListener('click', () => paused(!car.paused));
		}, { rootMargin: '300px' }).observe(root);
	}
</script>

<style>
	.net {
		position: absolute;
		left: 0.75rem;
		right: 0.75rem;
		bottom: 0.75rem;
		height: 7.5rem;
		pointer-events: none;
	}
	.buttons {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	button {
		font: inherit;
		font-size: 0.875rem;
		font-weight: 550;
		height: 2.25rem;
		padding-inline: 1rem;
		border-radius: 0.5rem;
		border: 1px solid var(--sx-line-strong);
		background: var(--sx-page);
		color: var(--sx-ink);
		cursor: pointer;
	}
	button[aria-pressed='true'] {
		border-color: var(--sx-bio);
		color: var(--sx-bio);
	}
	.readout {
		margin: 0;
		padding: 0 1rem 0.875rem;
		font-family: var(--sx-mono);
		font-size: 0.75rem;
		color: var(--sx-muted);
	}
	.readout b {
		font-weight: 500;
		color: var(--sx-ink-2);
	}
</style>
