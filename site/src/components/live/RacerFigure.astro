---
// The racer of the front page in a figure: the trained network driving tracks the reader picks or draws
// (src/widgets/racer/hero.ts on src/engines/racer.ts, held to sparx).
import Figure from './Figure.astro';
---

<div class="racer-figure" data-racer-figure>
	<Figure engine="Racer" height="26rem">
		<canvas data-racer-stage role="img" aria-label="A car driven by a spiking network around a closed track from its event camera's output, above the camera's pixels as they fire, the network's 160 neurons as they spike, and its steering and speed"></canvas>
		<div class="net" data-racer-net aria-hidden="true"></div>
		<div slot="controls" class="sx-buttons">
			<button class="sx-button" type="button" data-racer-act="track">New track</button>
			<button class="sx-button" type="button" data-racer-act="draw" aria-pressed="false">Draw a track</button>
			<button class="sx-button" type="button" data-racer-act="pause" aria-pressed="false">Pause</button>
		</div>
		<p slot="after" class="sx-readout">
			events <b data-racer-events>0</b> · spikes <b data-racer-spikes>0</b> a step · <b data-racer-lap>…</b>
		</p>
	</Figure>
</div>

<script>
	import { mountRacer } from '../../widgets/racer/hero';
	import { whenNear } from '../../widgets/theme';

	for (const root of document.querySelectorAll<HTMLElement>('[data-racer-figure]')) {
		whenNear(root, async () => mountRacer(root, await (await fetch('/racer/racer.json')).json(), (laps) => `lap ${laps + 1} under way`));
	}
</script>

<style>
	.net {
		position: absolute;
		left: 0.75rem;
		right: 0.75rem;
		bottom: 0.75rem;
		height: 7.5rem;
		pointer-events: none;
	}
	.sx-button[aria-pressed='true'] {
		border-color: var(--sx-bio);
		color: var(--sx-bio);
	}
</style>
