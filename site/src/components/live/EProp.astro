---
// e-prop against BPTT on one recurrent spiking network, trained live (src/widgets/eprop.ts).
import Figure from './Figure.astro';
---

<div data-eprop>
	<Figure engine="sparx.learn.eprop · BPTT" height="18rem">
		<canvas role="img" aria-label="Two copies of a recurrent spiking network learning to draw a target curve, one by e-prop and one by backpropagation through time, with their losses"></canvas>
		<div slot="controls" class="sx-buttons">
			<button type="button" data-act="train" class="sx-button primary">Train both</button>
			<button class="sx-button" type="button" data-act="reset">Start over</button>
		</div>
		<p slot="after" class="sx-readout" data-status aria-live="off"></p>
	</Figure>
</div>

<script>
	import { epropFigure } from '../../widgets/eprop';

	for (const root of document.querySelectorAll<HTMLElement>('[data-eprop]')) epropFigure(root);
</script>

<style>
	.sx-buttons {
		grid-column: 1 / -1;
	}
	.sx-button.primary {
		min-width: 7rem;
	}
</style>
