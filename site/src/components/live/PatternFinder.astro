---
// One neuron finding a repeated pattern among its afferents by STDP (src/widgets/plasticity.ts).
import Choice from './Choice.astro';
import Figure from './Figure.astro';
---

<div data-pattern>
	<Figure engine="LeakyIntegrateAndFire + PairSTDP" height="22rem">
		<canvas role="img" aria-label="Afferent spikes with the hidden pattern's windows shaded, the neuron's membrane and spikes, and the weights of the pattern's afferents and the others"></canvas>
		<Fragment slot="controls">
			<Choice name="speed" label="Speed" value="10" options={[{ value: '1', label: 'Real time' }, { value: '10', label: '10×' }, { value: '40', label: '40×' }]} />
			<Choice name="learning" label="Learning" value="on" options={[{ value: 'on', label: 'Learning' }, { value: 'off', label: 'Frozen' }]} />
			<div><button class="sx-button" type="button" data-act="reset">Start over</button></div>
		</Fragment>
		<p slot="after" class="sx-readout" data-status aria-live="off"></p>
	</Figure>
</div>

<script>
	import { controls } from '../../widgets/controls';
	import { type PatternFigure, patternFigure } from '../../widgets/plasticity';

	for (const root of document.querySelectorAll<HTMLElement>('[data-pattern]')) {
		let figure: PatternFigure | null = null;
		const ui = controls(root, (name) => {
			if (!figure) return;
			if (name === 'speed') figure.setSpeed(Number(ui.choice('speed')));
			if (name === 'learning') figure.setLearning(ui.choice('learning') === 'on');
		});
		new IntersectionObserver(([entry], observer) => {
			if (!entry.isIntersecting) return;
			figure = patternFigure(root);
			observer.disconnect();
		}).observe(root);
		root.querySelector('[data-act="reset"]')?.addEventListener('click', () => figure?.reset());
	}
</script>
