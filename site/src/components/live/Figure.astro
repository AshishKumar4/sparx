---
// A live figure: what runs, the canvas, its controls and a caption. `engine` names the sparx model the
// browser steps, shown in the corner.
interface Props {
	engine?: string;
	caption?: string;
	class?: string;
	height?: string;
}
const { engine, caption, class: className, height = '16rem' } = Astro.props;
---

<figure class:list={['live-figure', className]} style={`--figure-height: ${height}`}>
	<div class="stage">
		<slot />
		{engine && <span class="engine"><span class="dot" aria-hidden="true"></span>{engine}</span>}
	</div>
	{Astro.slots.has('controls') && <div class="controls"><slot name="controls" /></div>}
	{caption && <figcaption>{caption}</figcaption>}
	<slot name="after" />
</figure>

<style>
	.live-figure {
		margin: 0;
		border: 1px solid var(--sx-line);
		border-radius: 0.75rem;
		background: var(--sx-panel);
		overflow: hidden;
	}
	.stage {
		position: relative;
		height: var(--figure-height);
		background: var(--sx-page);
		border-bottom: 1px solid var(--sx-line);
	}
	.stage :global(canvas) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.engine {
		position: absolute;
		top: 0.625rem;
		right: 0.75rem;
		display: inline-flex;
		gap: 0.4rem;
		align-items: center;
		font-family: var(--sx-mono);
		font-size: 0.6875rem;
		color: var(--sx-muted);
		background: color-mix(in srgb, var(--sx-page) 85%, transparent);
		padding: 0.125rem 0.375rem;
		border-radius: 0.25rem;
		pointer-events: none;
	}
	.dot {
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 50%;
		background: var(--sx-spike);
	}
	.controls {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
		gap: 0.875rem 1.25rem;
		padding: 0.875rem 1rem 1rem;
		align-items: end;
	}
	figcaption {
		padding: 0 1rem 0.875rem;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--sx-muted);
	}
</style>
