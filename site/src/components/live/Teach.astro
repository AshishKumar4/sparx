---
// One LIF neuron taught, live, to fire at the times the reader marks (src/widgets/teach.ts).
import Choice from './Choice.astro';
import Figure from './Figure.astro';

const names = ['ATan', 'FastSigmoid', 'Triangle', 'Gaussian', 'StraightThrough'];
---

<div data-teach>
	<Figure engine="LIFCell + jax.grad" height="24rem">
		<canvas role="img" aria-label="Forty input spike trains, the neuron's membrane and spikes, the target times, and the loss falling as gradient descent trains the input weights"></canvas>
		<Fragment slot="controls">
			<div class="sx-buttons">
				<button type="button" data-act="train" aria-pressed="false" class="sx-button primary">Train</button>
				<button class="sx-button" type="button" data-act="reset">Reset weights</button>
			</div>
			<Choice name="surrogate" label="Surrogate" value="ATan" options={names.map((n) => ({ value: n, label: n }))} />
		</Fragment>
		<p slot="after" class="sx-readout" data-status aria-live="polite"></p>
	</Figure>
</div>

<script>
	import { controls } from '../../widgets/controls';
	import { teacher } from '../../widgets/teach';

	for (const root of document.querySelectorAll<HTMLElement>('[data-teach]')) {
		const teach = teacher(root);
		const ui = controls(root, () => teach.setSurrogate(ui.choice('surrogate')));
	}
</script>

<style>
	.sx-button.primary {
		min-width: 5.5rem;
	}
</style>
