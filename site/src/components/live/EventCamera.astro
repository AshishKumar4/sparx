---
// A fan seen by a frame camera and by an event camera (src/widgets/events.ts), with the event camera's
// threshold and the fan's speed for the reader to set.
import Figure from './Figure.astro';
import Slider from './Slider.astro';
---

<div data-events>
	<Figure engine="event camera" height="15rem">
		<canvas role="img" aria-label="A turning fan as a frame camera sees it, every pixel's brightness, and as an event camera sees it, orange where a pixel brightened and blue where it darkened, only along the moving blades"></canvas>
		<Fragment slot="controls">
			<Slider name="speed" label="Fan speed" min={0} max={3} step={0.1} value={1} unit="turns/s" digits={1} />
			<Slider name="threshold" label="Threshold" min={0.05} max={0.6} step={0.005} value={0.15} digits={3} />
		</Fragment>
		<p slot="after" class="readout">
			72 × 40 pixels · <b data-rate>…</b> events a second, <b data-share>…</b> of the 2,880,000 values a camera at 1,000 frames a second sends
		</p>
	</Figure>
</div>

<script>
	import { controls } from '../../widgets/controls';
	import { eventFigure } from '../../widgets/events';

	for (const root of document.querySelectorAll<HTMLElement>('[data-events]')) {
		const rate = root.querySelector<HTMLElement>('[data-rate]') as HTMLElement;
		const share = root.querySelector<HTMLElement>('[data-share]') as HTMLElement;
		const ui = controls(root, () => figure.redraw());
		const figure = eventFigure(
			root.querySelector('canvas') as HTMLCanvasElement,
			() => ({ speed: ui.read('speed'), threshold: ui.read('threshold') }),
			(perSecond) => {
				rate.textContent = Math.round(perSecond).toLocaleString('en-US');
				share.textContent = `${((100 * perSecond) / 2_880_000).toFixed(2)}%`;
			},
		);
	}
</script>

<style>
	.readout {
		margin: 0;
		padding: 0 1rem 0.875rem;
		font-family: var(--sx-mono);
		font-size: 0.75rem;
		color: var(--sx-muted);
	}
	.readout b {
		font-weight: 500;
		color: var(--sx-ink-2);
	}
</style>
