---
// A membrane charged by a current step: the exact curve, sparx's exact steps and forward Euler's.
import Figure from './Figure.astro';
import Slider from './Slider.astro';
---

<div data-discretize>
	<Figure engine="exact vs Euler" height="15rem">
		<canvas role="img" aria-label="A membrane potential rising toward a target while a current is on and decaying after, drawn exactly, with the values of the exact step and of Euler's step at the chosen step size"></canvas>
		<Fragment slot="controls">
			<Slider name="dt" label="Step dt" min={0.5} max={25} step={0.5} value={5} unit="ms" digits={1} />
			<Slider name="tau" label="Time constant tau" min={2} max={40} step={1} value={10} unit="ms" digits={0} />
		</Fragment>
		<p slot="after" class="sx-readout" data-status aria-live="polite"></p>
	</Figure>
</div>

<script>
	import { controls } from '../../widgets/controls';
	import { discretize } from '../../widgets/discretize';

	for (const root of document.querySelectorAll<HTMLElement>('[data-discretize]')) {
		const ui = controls(root, () => draw());
		const draw = discretize(root, () => ({ m: { tau: ui.read('tau'), drive: 1.2, on: 10, off: 70, span: 120 }, dt: ui.read('dt') }));
	}
</script>
