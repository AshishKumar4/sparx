---
// A Learn page: a title and lede, then prose with live figures that run wider than the text, then the
// pages before and after it.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { explainers } from '../../data/learn.mjs';
import Explainers from '../Explainers.astro';
import '../../styles/page.css';

interface Props {
	slug: string;
	title: string;
	description: string;
}
const { slug, title, description } = Astro.props;
const at = explainers.findIndex((e) => e.slug === slug);
const entry = explainers[at];
const previous = explainers[at - 1];
const next = explainers[at + 1];
---

<StarlightPage frontmatter={{ title, description, template: 'splash' }} hasSidebar={false}>
	<div class="page learn not-content" style={`--role: var(--sx-${entry?.role ?? 'spike'})`}>
		<header class="intro">
			<p class="crumb"><a href="/learn/">Learn</a><span aria-hidden="true">/</span>{at + 1} of {explainers.length}</p>
			<h1>{title}</h1>
			<p class="lede">{description}</p>
		</header>
		<article class="body">
			<slot />
		</article>
		<nav class="pager" aria-label="Learn pages">
			{previous ? <a href={`/learn/${previous.slug}/`} class="prev"><span>Previous</span>{previous.title}</a> : <span />}
			{next && <a href={`/learn/${next.slug}/`} class="next"><span>Next</span>{next.title}</a>}
		</nav>
		<Explainers current={slug} title="All of Learn" />
	</div>
</StarlightPage>

<style>
	.learn {
		padding-inline: var(--sl-content-pad-x, 1rem);
		--measure: 42rem;
		--wide: 68rem;
	}
	.intro,
	.body > :global(*) {
		max-width: var(--measure);
		margin-inline: auto;
	}
	.intro {
		padding-block: 3rem 1rem;
	}
	.crumb {
		margin: 0 0 1rem;
		font-family: var(--sx-mono);
		font-size: 0.75rem;
		color: var(--sx-muted);
		display: flex;
		gap: 0.5rem;
	}
	.crumb a {
		color: var(--role);
		text-decoration: none;
	}
	h1 {
		margin: 0;
		font-size: clamp(2.1rem, 1.5rem + 2.6vw, 3.4rem);
		line-height: 1.04;
		letter-spacing: -0.04em;
		font-weight: 700;
		color: var(--sx-ink);
		text-wrap: balance;
	}
	.lede {
		margin: 1rem 0 0;
		font-size: 1.1875rem;
		line-height: 1.55;
		color: var(--sx-ink-2);
	}
	.body {
		padding-bottom: 3rem;
	}
	.body :global(h2) {
		margin: 3rem auto 0;
		font-size: 1.5rem;
		letter-spacing: -0.02em;
		font-weight: 650;
		color: var(--sx-ink);
	}
	.body :global(h3) {
		margin: 2rem auto 0;
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--sx-ink);
	}
	.body :global(p),
	.body :global(li) {
		font-size: 1.0625rem;
		line-height: 1.68;
		color: var(--sx-ink-2);
	}
	.body :global(p) {
		margin-top: 1rem;
		margin-bottom: 0;
	}
	.body :global(ul) {
		padding-left: 1.25rem;
		margin-top: 1rem;
	}
	.body :global(p code),
	.body :global(li code) {
		font-family: var(--sx-mono);
		font-size: 0.86em;
		color: var(--sx-ink);
		background: var(--sl-color-bg-inline-code);
		padding: 0.1em 0.3em;
		border-radius: 0.25rem;
	}
	.body :global(a) {
		color: var(--sx-ink);
		text-decoration-color: var(--sx-faint);
		text-underline-offset: 0.18em;
	}
	.body :global(.wide) {
		max-width: var(--wide);
		margin-block: 2rem;
	}
	.body :global(.code-block) {
		margin-top: 1.5rem;
	}
	.body :global(.checked) {
		margin-top: 1.5rem;
		padding: 1rem 1.125rem;
		border: 1px solid var(--sx-line);
		border-left: 3px solid var(--sx-bio);
		border-radius: 0.5rem;
		background: var(--sx-panel);
		font-size: 0.9375rem;
	}
	.body :global(.checked p) {
		margin: 0;
		font-size: 0.9375rem;
	}
	.body :global(.checked p + p) {
		margin-top: 0.5rem;
	}
	.pager {
		max-width: var(--wide);
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 2rem;
		border-top: 1px solid var(--sx-line);
	}
	.pager a {
		display: grid;
		gap: 0.25rem;
		text-decoration: none;
		color: var(--sx-ink);
		font-weight: 600;
		font-size: 1.0625rem;
	}
	.pager a span {
		font-family: var(--sx-mono);
		font-size: 0.75rem;
		font-weight: 400;
		color: var(--sx-muted);
	}
	.pager .next {
		text-align: right;
		margin-left: auto;
	}
</style>
