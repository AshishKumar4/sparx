---
// The racer's training curve (public/racer/racer.json's history, from site/lab/racer.py train), drawn when the
// site is built.
import model from '../../../public/racer/racer.json';
import Chart from '../Chart.astro';

const meta = model.meta as { trained: Record<string, number>; history: { step: number; distance: number; speed: number; seconds: number }[] };
const minutes = Math.round(meta.history.at(-1)!.seconds / 60);
---

<Chart
	title="The racer's mean distance from the middle of the road and its mean speed along the road during training"
	series={[
		{ points: meta.history.map((h) => [h.step, h.speed] as [number, number]), role: 'spike' },
		{ points: meta.history.map((h) => [h.step, h.distance] as [number, number]), role: 'membrane' },
	]}
	x={{ label: 'training step', ticks: [0, 1000, 2000, 3000], min: 0, max: meta.trained.steps }}
	y={{ label: 'm or m/s', ticks: [0, 1, 2, 3, 4], min: 0, max: 4 }}
>
	Orange is the cars' mean speed along the road, blue their mean distance from its middle, over each training batch of
	{meta.trained.batch} cars on fresh tracks for {(meta.trained.horizon * 0.02).toFixed(0)} s. {meta.trained.steps.toLocaleString('en-US')}
	steps took {minutes} minutes on a CPU.
</Chart>
