---
// Cards for the Learn pages.
import { explainers } from '../data/learn.mjs';

interface Props {
	current?: string;
	title?: string;
}
const { current, title = 'Learn by changing things' } = Astro.props;
const shown = explainers.filter((e) => e.slug !== current);
---

<section class="explainers" aria-labelledby="explainers-title">
	<h2 id="explainers-title">{title}</h2>
	<ul>
		{
			shown.map((e) => (
				<li style={`--role: var(--sx-${e.role})`}>
					<a href={`/learn/${e.slug}/`}>
						<span class="title">{e.title}</span>
						<span class="summary">{e.summary}</span>
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.explainers {
		max-width: 80rem;
		margin-inline: auto;
		padding-block: 4.5rem;
		border-bottom: 1px solid var(--sx-line);
	}
	h2 {
		margin: 0 0 1.75rem;
		font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
		letter-spacing: -0.03em;
		font-weight: 650;
		color: var(--sx-ink);
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
		gap: 0.75rem;
	}
	a {
		display: grid;
		align-content: start;
		gap: 0.5rem;
		height: 100%;
		padding: 1.125rem 1.25rem 1.25rem;
		border: 1px solid var(--sx-line);
		border-radius: 0.75rem;
		text-decoration: none;
		background: var(--sx-panel);
		position: relative;
		transition: border-color 0.15s;
	}
	a::before {
		content: '';
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--role);
	}
	a:hover {
		border-color: var(--sx-faint);
	}
	.title {
		font-weight: 600;
		color: var(--sx-ink);
	}
	.summary {
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--sx-muted);
	}
	@media (max-width: 40rem) {
		.explainers {
			padding-block: 3rem;
		}
		ul {
			grid-template-columns: 1fr 1fr;
			gap: 0.5rem;
		}
		a {
			padding: 0.875rem;
			gap: 0.375rem;
		}
		.summary {
			display: none;
		}
	}
</style>
