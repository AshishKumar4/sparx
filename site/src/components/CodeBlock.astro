---
// sparx code beside a figure, with where it comes from and a notebook that runs it.
import { Code } from '@astrojs/starlight/components';

interface Props {
	code: string;
	title?: string;
	colab?: string;
	source?: string;
}
const { code, title, colab, source } = Astro.props;
---

<div class="code-block">
	<Code code={code.trim()} lang="python" title={title} />
	{
		(colab || source) && (
			<div class="links">
				{colab && <a href={colab}>Run it in Colab</a>}
				{source && <a href={source}>Source</a>}
			</div>
		)
	}
</div>

<style>
	.code-block {
		min-width: 0;
	}
	.code-block :global(.expressive-code) {
		margin: 0;
	}
	.links {
		display: flex;
		gap: 1rem;
		margin-top: 0.5rem;
		font-size: 0.8125rem;
	}
	.links a {
		color: var(--sx-muted);
		text-decoration: none;
	}
	.links a:hover {
		color: var(--sx-ink);
	}
	.links a::after {
		content: ' →';
	}
</style>
