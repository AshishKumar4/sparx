---
// sparx code beside a figure, with where it comes from and a notebook that runs it. With `fold`, as on the
// front page, a phone shows it folded behind a tap so the page reads as a story; the course shows it inline.
import { Code } from '@astrojs/starlight/components';

interface Props {
	code: string;
	title?: string;
	colab?: string;
	source?: string;
	fold?: boolean;
}
const { code, title, colab, source, fold = false } = Astro.props;
const Box = fold ? 'details' : 'div';
---

<Box class="code-block not-content" open={fold || undefined}>
	{fold && <summary>The code</summary>}
	<Code code={code.trim()} lang="python" title={title} wrap preserveIndent />
	{
		(colab || source) && (
			<div class="links">
				{colab && <a href={colab}>Run it in Colab</a>}
				{source && <a href={source}>Source</a>}
			</div>
		)
	}
</Box>
{
	fold && (
		<script is:inline>
			if (matchMedia('(max-width: 63.99rem)').matches) document.currentScript.previousElementSibling.open = false;
		</script>
	)
}

<style>
	.code-block {
		min-width: 0;
	}
	summary {
		display: none;
		cursor: pointer;
		font-size: 0.875rem;
		font-weight: 550;
		color: var(--sx-ink);
		padding: 0.625rem 0.875rem;
		border: 1px solid var(--sx-line);
		border-radius: 0.5rem;
		background: var(--sx-panel);
		list-style-position: inside;
	}
	.code-block[open] summary {
		margin-bottom: 0.5rem;
	}
	@media (max-width: 63.99rem) {
		summary {
			display: list-item;
		}
	}
	.code-block :global(.expressive-code) {
		margin: 0;
	}
	.links {
		display: flex;
		gap: 1rem;
		margin-top: 0.5rem;
		font-size: 0.8125rem;
	}
	.links a {
		color: var(--sx-muted);
		text-decoration: none;
	}
	.links a:hover {
		color: var(--sx-ink);
	}
	.links a::after {
		content: ' →';
	}
</style>
