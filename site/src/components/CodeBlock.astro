---
// sparx code beside a figure, with where it comes from and a notebook that runs it.
import { Code } from '@astrojs/starlight/components';

interface Props {
	code: string;
	title?: string;
	colab?: string;
	source?: string;
}
const { code, title, colab, source } = Astro.props;
---

<details class="code-block" open>
	<summary>The code</summary>
	<Code code={code.trim()} lang="python" title={title} wrap preserveIndent />
	{
		(colab || source) && (
			<div class="links">
				{colab && <a href={colab}>Run it in Colab</a>}
				{source && <a href={source}>Source</a>}
			</div>
		)
	}
</details>
<script is:inline>
	// On a phone the code starts folded, so the page reads as a story; it is one tap away.
	if (matchMedia('(max-width: 63.99rem)').matches) document.currentScript.previousElementSibling.open = false;
</script>

<style>
	.code-block {
		min-width: 0;
	}
	summary {
		display: none;
		cursor: pointer;
		font-size: 0.875rem;
		font-weight: 550;
		color: var(--sx-ink);
		padding: 0.625rem 0.875rem;
		border: 1px solid var(--sx-line);
		border-radius: 0.5rem;
		background: var(--sx-panel);
		list-style-position: inside;
	}
	.code-block[open] summary {
		margin-bottom: 0.5rem;
	}
	@media (max-width: 63.99rem) {
		summary {
			display: list-item;
		}
	}
	.code-block :global(.expressive-code) {
		margin: 0;
	}
	.links {
		display: flex;
		gap: 1rem;
		margin-top: 0.5rem;
		font-size: 0.8125rem;
	}
	.links a {
		color: var(--sx-muted);
		text-decoration: none;
	}
	.links a:hover {
		color: var(--sx-ink);
	}
	.links a::after {
		content: ' →';
	}
</style>
