---
// The front page's hero: two networks sparx trained, live. The racer (src/widgets/racer/hero.ts) drives a
// car around a track the visitor draws, seeing the road only through its event camera; the drone
// (src/widgets/pilot/hero.ts) flies after the pointer. Each is drawn beside its network.
import model from '../../../public/pilot/pilot.json';
import racer from '../../../public/racer/evaluation.json';
import Install from '../Install.astro';

const evaluation = model.evaluation as Record<string, number>;
const arrived = Math.round(evaluation.arrived * 1000) / 10;
const laps = racer.summary;
const finished = Math.round(laps.finished * laps.tracks);
---

<section class="hero" data-hero data-mode="racer">
	<div class="stage">
		<canvas class="racer" data-racer-stage role="img" aria-label="A car driven by a spiking network around a closed track, seeing the road only through an event camera, beside the camera's pixels lighting as they fire, the network's 160 neurons lighting as they spike, and its steering and speed"></canvas>
		<div class="net racer" data-racer-net aria-hidden="true"></div>
		<canvas class="drone" data-stage role="img" aria-label="A drone flown by a spiking network toward the pointer, beside the network: its seven readings, two layers of 64 neurons that light up as they spike, and two readout neurons wired to the rotors"></canvas>
		<div class="net drone" data-net aria-hidden="true"></div>
	</div>
	<div class="copy">
		<h1>Spiking neural networks in&nbsp;JAX</h1>
		<p class="lede">
			Train them with gradients or local rules. Simulate circuits in millivolts and milliseconds. Built on Flax and{' '}
			<a href="https://dewml.dev">dew</a>, with every model checked against a reference.
		</p>
		<div class="actions">
			<a class="button primary" href="/learn/">How it works</a>
			<a class="button" href="/docs/">Docs</a>
			<Install />
		</div>
	</div>
	<div class="panel">
		<div class="tabs" role="tablist" aria-label="Trained network">
			<button type="button" role="tab" id="tab-racer" aria-controls="panel-racer" aria-selected="true" data-tab="racer">Racer</button>
			<button type="button" role="tab" id="tab-drone" aria-controls="panel-drone" aria-selected="false" tabindex="-1" data-tab="drone">Drone</button>
		</div>
		<div class="mode-panel racer" id="panel-racer" role="tabpanel" aria-labelledby="tab-racer" data-mode-panel="racer">
			<p class="caption">
				<span class="live" aria-hidden="true"></span>
				<span>
					<strong>This car is driven by 160 spiking neurons, live. They see the road only through an event camera.</strong>{' '}
					<span class="hint desk">Drag a loop anywhere around it to draw a new track.</span>
					<span class="hint touch">Tap Draw, then draw a loop around the track.</span>
				</span>
			</p>
			<div class="controls">
				<button type="button" data-racer-act="track">New track</button>
				<button type="button" data-racer-act="draw" aria-pressed="false">Draw</button>
				<button type="button" data-racer-act="pause" aria-pressed="false">Pause</button>
			</div>
			<p class="stats">
				<span>events <span data-racer-events>0</span> · spikes <span data-racer-spikes>0</span> a step</span>
				<span data-racer-lap></span>
				<span>trained end to end with sparx · finished {finished} of {laps.tracks} unseen tracks · <a href="/learn/racer/">how it learned</a></span>
			</p>
		</div>
		<div class="mode-panel drone" id="panel-drone" role="tabpanel" aria-labelledby="tab-drone" data-mode-panel="drone">
			<p class="caption">
				<span class="live" aria-hidden="true"></span>
				<span>
					<strong>This drone is flown by 128 spiking neurons, live.</strong>{' '}
					<span class="hint desk">Move your pointer and it follows. Click to push it, drag it to throw it, click a neuron to silence it.</span>
					<span class="hint touch">Tap anywhere to send it there. Tap a neuron to silence it.</span>
				</span>
			</p>
			<div class="controls">
				<button type="button" data-act="gust">Gust</button>
				<button type="button" data-act="flip">Flip</button>
				<button type="button" data-act="silence">Silence 16</button>
				<button type="button" data-act="restore" class="restore">Restore</button>
				<button type="button" data-act="pause" aria-pressed="false">Pause</button>
			</div>
			<p class="stats">
				<span>firing <span data-rate>0 Hz</span></span>
				<span class="silenced" data-silenced></span>
				<span>trained with sparx · reaches its target on {arrived}% of 1,000 starts · <a href="/learn/drone/">how it learned</a></span>
			</p>
		</div>
	</div>
</section>

<link rel="preload" href="/racer/racer.json" as="fetch" crossorigin="anonymous" />

<script>
	import { hero } from '../../widgets/pilot/hero';
	import { mountRacer } from '../../widgets/racer/hero';

	const root = document.querySelector<HTMLElement>('[data-hero]');
	if (root) {
		mountRacer(root, await (await fetch('/racer/racer.json')).json(), () => '');

		let drone: Promise<void> | null = null;
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
		const select = (tab: HTMLButtonElement) => {
			const mode = tab.dataset.tab as string;
			root.dataset.mode = mode;
			for (const other of tabs) {
				other.setAttribute('aria-selected', String(other === tab));
				other.tabIndex = other === tab ? 0 : -1;
			}
			if (mode === 'drone') drone ??= fetch('/pilot/pilot.json').then((r) => r.json()).then((m) => hero(root, m));
		};
		for (const [k, tab] of tabs.entries()) {
			tab.addEventListener('click', () => select(tab));
			tab.addEventListener('keydown', (event) => {
				const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
				if (!step) return;
				const next = tabs[(k + step + tabs.length) % tabs.length];
				select(next);
				next.focus();
			});
		}
	}
</script>

<style>
	.hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		grid-template-areas: 'stage' 'panel';
		margin-inline: calc(-1 * var(--sl-content-pad-x, 1rem));
		border-bottom: 1px solid var(--sx-line);
	}
	.stage {
		grid-area: stage;
		position: relative;
		height: max(36rem, calc(100svh - var(--sl-nav-height, 3.5rem)));
		border-bottom: 1px solid var(--sx-line);
		background: radial-gradient(ellipse at 50% 100%, var(--sx-membrane-soft), transparent 65%), var(--sx-page);
		touch-action: pan-y;
	}
	canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		cursor: crosshair;
		user-select: none;
	}
	.hero:global(.grabbing) canvas {
		cursor: grabbing;
	}
	.net {
		position: absolute;
		left: var(--sl-content-pad-x, 1rem);
		right: var(--sl-content-pad-x, 1rem);
		bottom: 1rem;
		height: min(16rem, 32%);
		pointer-events: none;
	}
	.copy {
		grid-area: stage;
		align-self: start;
		position: relative;
		z-index: 1;
		padding: 1.75rem var(--sl-content-pad-x, 1rem) 0;
		pointer-events: none;
	}
	.copy a,
	.copy :global(.install) {
		pointer-events: auto;
	}
	@media (max-width: 63.99rem) {
		.copy :global(.install) {
			display: none;
		}
	}
	h1 {
		font-size: clamp(2.4rem, 1.3rem + 4.2vw, 4.75rem);
		line-height: 0.98;
		letter-spacing: -0.045em;
		font-weight: 700;
		color: var(--sx-ink);
		margin: 0;
		max-width: 13ch;
		text-wrap: balance;
	}
	.lede {
		margin: 1rem 0 0;
		font-size: clamp(1rem, 0.92rem + 0.35vw, 1.2rem);
		line-height: 1.5;
		color: var(--sx-ink-2);
		max-width: 31rem;
	}
	.lede a {
		color: inherit;
		text-decoration-color: var(--sx-faint);
		text-underline-offset: 0.18em;
	}
	.actions {
		margin-top: 1.5rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		align-items: center;
	}
	.button {
		display: inline-flex;
		align-items: center;
		height: 2.5rem;
		padding-inline: 1rem;
		border-radius: 0.5rem;
		border: 1px solid var(--sx-line-strong);
		color: var(--sx-ink);
		text-decoration: none;
		font-weight: 550;
		font-size: 0.9375rem;
		background: var(--sx-page);
	}
	.button:hover {
		border-color: var(--sx-faint);
	}
	.button.primary {
		background: var(--sx-ink);
		color: var(--sx-page);
		border-color: var(--sx-ink);
	}
	.hero[data-mode='racer'] .drone,
	.hero[data-mode='drone'] .racer {
		display: none;
	}
	.tabs {
		display: inline-flex;
		gap: 0.25rem;
		padding: 0.1875rem;
		border: 1px solid var(--sx-line);
		border-radius: 0.5rem;
		background: var(--sx-panel);
		justify-self: start;
	}
	.tabs button {
		font: inherit;
		font-size: 0.8125rem;
		font-weight: 550;
		height: 1.875rem;
		padding-inline: 0.875rem;
		border: 0;
		border-radius: 0.375rem;
		background: none;
		color: var(--sx-muted);
		cursor: pointer;
	}
	.tabs button[aria-selected='true'] {
		background: var(--sx-ink);
		color: var(--sx-page);
	}
	.mode-panel {
		display: grid;
		gap: 0.75rem;
	}
	.hero[data-racer-paused='true'] .racer .live {
		background: var(--sx-faint);
		box-shadow: none;
	}
	.hero[data-drawing='true'] canvas.racer {
		cursor: crosshair;
	}
	.panel {
		grid-area: panel;
		position: relative;
		z-index: 1;
		display: grid;
		gap: 0.75rem;
		padding: 1rem var(--sl-content-pad-x, 1rem) 1.5rem;
	}
	.caption {
		display: flex;
		gap: 0.625rem;
		align-items: baseline;
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.45;
		color: var(--sx-ink-2);
	}
	.caption strong {
		color: var(--sx-ink);
		font-weight: 600;
	}
	.live {
		flex: none;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--sx-spike);
		box-shadow: 0 0 0 0.25rem var(--sx-spike-soft);
		translate: 0 -0.05rem;
	}
	.hero[data-paused='true'] .drone .live {
		background: var(--sx-faint);
		box-shadow: none;
	}
	.hint.desk {
		display: none;
	}
	@media (hover: hover) and (pointer: fine) {
		.hint.desk {
			display: inline;
		}
		.hint.touch {
			display: none;
		}
	}
	.controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}
	.controls button {
		font: inherit;
		font-size: 0.8125rem;
		font-weight: 500;
		height: 2rem;
		padding-inline: 0.75rem;
		border-radius: 0.375rem;
		border: 1px solid var(--sx-line-strong);
		background: var(--sx-page);
		color: var(--sx-ink);
		cursor: pointer;
	}
	.controls button:hover {
		border-color: var(--sx-faint);
	}
	.hero:not([data-silenced]) .restore,
	.hero[data-silenced='0'] .restore {
		display: none;
	}
	.stats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin: 0;
		font-family: var(--sx-mono);
		font-size: 0.75rem;
		color: var(--sx-muted);
	}
	.stats a {
		color: var(--sx-ink);
	}
	[data-rate],
	.silenced {
		color: var(--sx-spike);
	}

	@media (min-width: 64rem) {
		.hero {
			display: block;
			height: calc(100svh - var(--sl-nav-height, 3.5rem));
			min-height: 40rem;
			max-height: 60rem;
		}
		.stage {
			position: absolute;
			inset: 0;
			height: auto;
			border: 0;
		}
		.net {
			left: max(2.5rem, calc((100vw - 84rem) / 2));
			right: auto;
			bottom: 2.5rem;
			width: min(40rem, 47vw);
			height: min(19rem, 38%);
		}
		.copy {
			position: absolute;
			top: clamp(2rem, 7svh, 5rem);
			left: max(2.5rem, calc((100vw - 84rem) / 2));
			padding: 0;
		}
		.panel {
			position: absolute;
			right: max(2.5rem, calc((100vw - 84rem) / 2));
			bottom: 2.5rem;
			width: min(25rem, 30vw);
			padding: 0;
			justify-items: end;
			text-align: right;
		}
		.caption {
			flex-direction: row-reverse;
		}
		.controls,
		.stats {
			justify-content: flex-end;
		}
		.tabs,
		.mode-panel {
			justify-self: end;
		}
		.mode-panel {
			justify-items: end;
		}
	}
</style>
