---
// The site's header on every page: the wordmark, the sections, search, GitHub and the theme.
import Search from 'virtual:starlight/components/Search';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { sections, sectionOf } from '../../nav.mjs';
import Wordmark from '../Wordmark.astro';

const current = sectionOf(Astro.url.pathname);
---

<div class="header">
	<div class="left">
		<a href="/" class="home" aria-label="sparx home"><Wordmark /></a>
		<nav class="sections" aria-label="Sections">
			{
				sections.map((section) => (
					<a href={section.href} aria-current={section.key === current ? 'page' : undefined}>
						{section.label}
					</a>
				))
			}
		</nav>
	</div>
	<div class="search print:hidden">
		<Search />
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right">
		<SocialIcons />
		<ThemeSelect />
	</div>
</div>

<style>
	.header {
		display: flex;
		gap: 1rem;
		justify-content: space-between;
		align-items: center;
		height: 100%;
	}
	.left {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		min-width: 0;
	}
	.home {
		text-decoration: none;
		padding: 0.25rem 0.125rem;
		border-radius: 0.25rem;
	}
	.sections {
		display: flex;
		gap: 0.125rem;
	}
	.sections a {
		color: var(--sx-muted);
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 500;
		padding: 0.375rem 0.5rem;
		border-radius: 0.375rem;
		white-space: nowrap;
	}
	.sections a:hover {
		color: var(--sx-ink);
	}
	.sections a[aria-current='page'] {
		color: var(--sx-ink);
		background: var(--sx-raised);
	}
	.search {
		display: flex;
		flex: 1;
		justify-content: flex-end;
	}
	.right {
		gap: 1rem;
		align-items: center;
	}
	@media (min-width: 50rem) {
		.header {
			gap: 2rem;
		}
		.search {
			justify-content: center;
		}
		.sections a {
			padding: 0.375rem 0.625rem;
		}
	}
	@media (max-width: 26rem) {
		.left {
			gap: 0.5rem;
		}
		.sections a {
			padding: 0.375rem 0.375rem;
		}
	}
</style>
