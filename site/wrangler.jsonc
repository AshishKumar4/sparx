// sparxml.dev: the built site as static assets, no Worker code. `pnpm build`, then `pnpm run deploy`,
// which also deploys deploy/redirect (sparx.sh and the www hosts).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sparx-site",
	"account_id": "f44999d1ddda7012e9a87729eba250f1",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"routes": [{ "pattern": "sparxml.dev", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false
}
